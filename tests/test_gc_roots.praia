use "testing"

// Values held only by native code (a native's locals, a native closure's
// captures, SharedMap/Queue storage, another thread) must survive a
// collection. Each test churns enough allocations to force at least one
// GC while such a value is live. Run with PRAIA_GC_STRESS=1 to collect
// at every opportunity instead.

func churn() {
    for (i in 0..12000) { let t = [i, [i]] }
}

testing.test("map result survives GC during callbacks", lam{ in
    let nums = []
    for (i in 0..5000) { nums.push(i) }
    let r = map(nums, lam{ n in {id: n, tags: [n]} })
    testing.expectEqual(len(r), 5000, nil)
    testing.expectEqual(r[4999].tags, [4999], nil)
})

testing.test("filter result survives GC during callbacks", lam{ in
    let recs = []
    for (i in 0..5000) { recs.push({id: i}) }
    let ev = filter(recs, lam{ r in r.id % 2 == 0 })
    testing.expectEqual(len(ev), 2500, nil)
})

testing.test("callback arguments survive GC inside the callback", lam{ in
    let src = [[1], [2], [3]]
    let r = map(src, lam{ x in
        churn()
        return x
    })
    testing.expectEqual(r, [[1], [2], [3]], nil)
})

testing.test("sort with an allocating comparator", lam{ in
    let r = sort([[3], [1], [2]], lam{ a, b in
        churn()
        return a[0] < b[0]
    })
    testing.expectEqual(r, [[1], [2], [3]], nil)
})

testing.test("bound method keeps its receiver", lam{ in
    let g = [[1], [2], [3]].sorted
    churn()
    testing.expectEqual(g(), [[1], [2], [3]], nil)
})

testing.test("SharedMap entries survive GC", lam{ in
    let sm = SharedMap()
    sm.set("a", [1, 2, 3])
    churn()
    testing.expectEqual(sm.get("a"), [1, 2, 3], nil)
})

testing.test("Queue contents survive GC", lam{ in
    let q = Queue()
    q.send({x: [4, 5]})
    churn()
    testing.expectEqual(q.recv(), {x: [4, 5]}, nil)
})

testing.test("generator locals survive GC between yields", lam{ in
    func gen() {
        let local = [1, 2, 3]
        yield 0
        churn()
        yield local
    }
    let it = gen()
    it.next()
    testing.expectEqual(it.next().value, [1, 2, 3], nil)
})

testing.test("closure returned from async task keeps its captures", lam{ in
    // Its upvalues live in the task's ownership bag, not the VM's.
    func mk(arr) { return lam{ in arr } }
    let c = await async mk([1, [2, 3]])
    c().push(c)   // cycle through the task-owned upvalue
    churn()
    let arr = c()
    testing.expectEqual(arr[0], 1, nil)
    testing.expectEqual(arr[1], [2, 3], nil)
    testing.expectEqual(len(arr), 3, nil)
})

testing.test("async task closure that captures itself survives GC", lam{ in
    // The closure sits in its own task-owned upvalue: bag -> upvalue ->
    // closure -> bag. Reachable, so the collector must keep it.
    func mk(arr) {
        let f = nil
        func h(n) {
            if (n <= 0) { return arr }
            return f(n - 1)
        }
        f = h
        return f
    }
    let c = await async mk([1, [2, 3]])
    churn()
    testing.expectEqual(c(5), [1, [2, 3]], nil)
})

testing.test("closure passed through a later task keeps its own task's captures", lam{ in
    func mk(arr) { return lam{ in arr } }
    func pass(f) { return f }
    let c = await async mk([4, [5, 6]])
    let d = await async pass(c)
    c = nil   // d is all that holds the first task's bag now
    churn()
    testing.expectEqual(d(), [4, [5, 6]], nil)
})

testing.test("values sent through a Queue survive GC on both sides", lam{ in
    let q = Queue()
    let consumer = async lam{ in
        let total = 0
        for (i in 0..50) {
            let v = q.recv()
            v.items.push(i)
            total = total + len(v.items)
        }
        return total
    }()
    for (i in 0..50) {
        let msg = {items: [i]}
        msg.self = msg   // a cycle the sender's collector no longer owns
        q.send(msg)
        churn()
    }
    testing.expectEqual(await consumer, 100, nil)
})

testing.test("SharedMap values survive GC while tasks update them", lam{ in
    let jobs = SharedMap()
    jobs.set("j", {log: []})
    func work(n) {
        for (i in 0..n) { jobs.update("j", lam{ s in s.log.push(i); return s }) }
        return n
    }
    let fs = [async work(50), async work(50)]
    churn()
    for (f in fs) { await f }
    testing.expectEqual(len(jobs.get("j").log), 100, nil)
})

testing.test("task result moves to the caller's collector", lam{ in
    func build() {
        let a = {name: "a"}
        let b = {name: "b", peer: a}
        a.peer = b
        return [a, b]
    }
    let r = await async build()
    churn()
    testing.expectEqual(r[0].peer.name, "b", nil)
    testing.expectEqual(r[1].peer.peer.name, "b", nil)
})

testing.done()
