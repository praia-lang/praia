use "testing"

testing.test("basic yield and next", lam{ in
    func gen() { yield 1; yield 2; yield 3 }
    let g = gen()
    testing.expectEqual(g.next().value, 1, nil)
    testing.expectEqual(g.next().value, 2, nil)
    testing.expectEqual(g.next().value, 3, nil)
    testing.expect(g.next().done, "should be done")
})

testing.test("generator exhaustion returns done", lam{ in
    func gen() { yield 42 }
    let g = gen()
    let r1 = g.next()
    testing.expectEqual(r1.value, 42, nil)
    testing.expectEqual(r1.done, false, nil)
    let r2 = g.next()
    testing.expectEqual(r2.done, true, nil)
    // Calling next after done still returns done
    let r3 = g.next()
    testing.expectEqual(r3.done, true, nil)
})

testing.test("for-in over generator", lam{ in
    func range(n) {
        for (i in 0..n) { yield i }
    }
    let result = []
    for (x in range(5)) { push(result, x) }
    testing.expectEqual(result, [0, 1, 2, 3, 4], nil)
})

testing.test("infinite generator with break", lam{ in
    func naturals() {
        let n = 0
        while (true) { yield n; n = n + 1 }
    }
    let result = []
    for (x in naturals()) {
        if (x >= 5) { break }
        push(result, x)
    }
    testing.expectEqual(result, [0, 1, 2, 3, 4], nil)
})

testing.test("yield as expression receives send value", lam{ in
    func acc() {
        let total = 0
        while (true) {
            let val = yield total
            total = total + val
        }
    }
    let g = acc()
    g.next()              // prime
    testing.expectEqual(g.next(10).value, 10, nil)
    testing.expectEqual(g.next(5).value, 15, nil)
    testing.expectEqual(g.next(25).value, 40, nil)
})

testing.test("generator with closure", lam{ in
    let base = 100
    func gen() {
        yield base + 1
        yield base + 2
    }
    let g = gen()
    testing.expectEqual(g.next().value, 101, nil)
    testing.expectEqual(g.next().value, 102, nil)
})

testing.test("nested yield in loops", lam{ in
    func pairs() {
        for (i in 0..3) {
            for (j in 0..2) {
                yield [i, j]
            }
        }
    }
    let result = []
    for (p in pairs()) { push(result, p) }
    testing.expectEqual(len(result), 6, nil)
    testing.expectEqual(result[0], [0, 0], nil)
    testing.expectEqual(result[5], [2, 1], nil)
})

testing.test("generator lambda", lam{ in
    let gen = lam{ n in for (i in 0..n) { yield i * i } }
    let result = []
    for (x in gen(4)) { push(result, x) }
    testing.expectEqual(result, [0, 1, 4, 9], nil)
})

testing.test("multiple generators interleaved", lam{ in
    func gen(start) {
        yield start
        yield start + 1
    }
    let a = gen(10)
    let b = gen(20)
    testing.expectEqual(a.next().value, 10, nil)
    testing.expectEqual(b.next().value, 20, nil)
    testing.expectEqual(a.next().value, 11, nil)
    testing.expectEqual(b.next().value, 21, nil)
})

testing.test(".done property", lam{ in
    func gen() { yield 1 }
    let g = gen()
    testing.expectEqual(g.done, false, nil)
    g.next()
    g.next()
    testing.expectEqual(g.done, true, nil)
})

testing.test("generator with return value", lam{ in
    func gen() {
        yield 1
        return 99
    }
    let g = gen()
    testing.expectEqual(g.next().value, 1, nil)
    let last = g.next()
    testing.expectEqual(last.value, 99, nil)
    testing.expectEqual(last.done, true, nil)
})

testing.test("bare yield produces nil", lam{ in
    func gen() { yield }
    let g = gen()
    testing.expectEqual(g.next().value, nil, nil)
})

testing.test("error in generator propagates to caller", lam{ in
    func bad() {
        yield 1
        throw "boom"
    }
    let g = bad()
    testing.expectEqual(g.next().value, 1, nil)
    testing.expectThrows(lam{ in g.next() }, nil)
})

testing.test("generator with default params", lam{ in
    func gen(start = 0, step = 1) {
        let n = start
        yield n; n = n + step
        yield n; n = n + step
        yield n
    }
    let result = []
    for (x in gen(10, 5)) { push(result, x) }
    testing.expectEqual(result, [10, 15, 20], nil)
})

testing.test("for-in still works with arrays", lam{ in
    let result = []
    for (x in [10, 20, 30]) { push(result, x) }
    testing.expectEqual(result, [10, 20, 30], nil)
})

testing.test("for-in still works with maps", lam{ in
    let result = []
    for ({key, value} in {a: 1}) {
        push(result, key)
        push(result, value)
    }
    testing.expectEqual(result, ["a", 1], nil)
})

testing.test("for-in still works with strings", lam{ in
    let result = []
    for (c in "abc") { push(result, c) }
    testing.expectEqual(result, ["a", "b", "c"], nil)
})

// A try that's open when the generator yields is still its own when it
// resumes, and doesn't catch the caller's errors in between
testing.test("try across a yield", lam{ in
    func g() {
        try {
            yield 1
            throw "inner"
        } catch (e) {
            yield "caught " + e
        }
        yield "after"
    }
    let it = g()
    testing.expectEqual(it.next().value, 1, nil)
    let outer = nil
    try { throw "outer" } catch (e) { outer = e }
    testing.expectEqual(outer, "outer", "the caller's catch, not the generator's")
    testing.expectEqual(it.next().value, "caught inner", nil)
    testing.expectEqual(it.next().value, "after", nil)
    testing.expect(it.next().done, "done")
})

testing.test("nested tries across yields", lam{ in
    func g() {
        try {
            try {
                yield 1
                throw "a"
            } catch (e) {
                yield "inner " + e
                throw "b"
            }
        } catch (e) {
            yield "outer " + e
        }
    }
    let got = []
    for (v in g()) { got.push(v) }
    testing.expectEqual(got, [1, "inner a", "outer b"], nil)
})

testing.test("an abandoned generator's try doesn't catch later errors", lam{ in
    func g() {
        try { yield 1 } catch (e) { yield "generator caught " + e }
    }
    let it = g()
    it.next()
    it = nil
    let msg = nil
    try { throw "later" } catch (e) { msg = e }
    testing.expectEqual(msg, "later", nil)
})

// A generator's defers run when it finishes, as a function's do: not at
// a yield, and not in whatever the caller runs while it's suspended
let deferLog = []

func otherCall() { return "other" }

func deferring() {
    defer deferLog.push("first")
    yield 1
    defer deferLog.push("second")
    yield 2
}

testing.test("defers wait for the generator to finish", lam{ in
    deferLog = []
    let it = deferring()
    it.next()
    otherCall()
    testing.expectEqual(deferLog, [], "not at the first yield")
    it.next()
    otherCall()
    testing.expectEqual(deferLog, [], "not at the second yield")
    testing.expect(it.next().done, "done")
    testing.expectEqual(deferLog, ["second", "first"], "last registered first")
})

testing.test("defers run when a generator throws or returns", lam{ in
    deferLog = []
    func throwing() {
        defer deferLog.push("thrown")
        yield 1
        throw "bad"
    }
    let t = throwing()
    t.next()
    testing.expectThrows(lam{ in t.next() }, nil)
    func returning() {
        defer deferLog.push("returned")
        yield 1
        return 9
    }
    let r = returning()
    r.next()
    testing.expectEqual(r.next().value, 9, nil)
    testing.expectEqual(deferLog, ["thrown", "returned"], nil)
})

testing.test("defers run when a for loop finishes a generator", lam{ in
    deferLog = []
    let got = []
    for (x in deferring()) { got.push(x) }
    testing.expectEqual(got, [1, 2], nil)
    testing.expectEqual(deferLog, ["second", "first"], nil)
})

testing.test("an abandoned generator doesn't run its defers", lam{ in
    deferLog = []
    let it = deferring()
    it.next()
    it = nil
    otherCall()
    testing.expectEqual(deferLog, [], nil)
})

testing.done()
