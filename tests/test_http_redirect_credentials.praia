use "testing"
use "./fixtures/ports"

let _LH = {blockPrivateHosts: false}

// Regression: following a redirect to another origin must not forward
// the caller's credentials — standard credential headers or custom ones
// like X-API-Key. Only standard non-credential headers survive unless
// the caller passes redirectHeaders: "all". Requests go to localhost;
// /cross redirects to 127.0.0.1 — a different host, so a different
// origin, on the same server. /echo replies with the names of the
// watched headers it received.

let TEST_PORT = ports.freePort()

let _serverFuture = async lam{ in
    let s = net.listen(TEST_PORT)
    while (true) {
        let c = net.accept(s)
        let req = ""
        while (!req.contains("\r\n\r\n")) {
            let chunk = net.recv(c, 4096)
            if (len(chunk) == 0) { break }
            req = req + chunk
        }
        let firstSp = req.indexOf(" ")
        let method = req.slice(0, firstSp)
        let after = req.slice(firstSp + 1, len(req))
        let path = after.slice(0, after.indexOf(" "))

        let resp = ""
        if (path == "/cross") {
            resp = "HTTP/1.1 302 Found\r\nLocation: http://127.0.0.1:" + str(TEST_PORT) + "/echo\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
        }
        elif (path == "/same") {
            resp = "HTTP/1.1 302 Found\r\nLocation: /echo\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
        }
        elif (path == "/cross307") {
            resp = "HTTP/1.1 307 Temporary Redirect\r\nLocation: http://127.0.0.1:" + str(TEST_PORT) + "/echobody\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
        }
        elif (path == "/same307") {
            resp = "HTTP/1.1 307 Temporary Redirect\r\nLocation: /echobody\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
        }
        elif (path == "/echobody") {
            // Replies "<method> <body>" with the full body it received.
            // Split rather than index: strings index by grapheme, and
            // "\r\n" is a single grapheme.
            let parts = req.split("\r\n\r\n")
            let clen = 0
            for (line in parts[0].split("\r\n")) {
                if (line.lower().startsWith("content-length:")) {
                    clen = int(line.slice(line.indexOf(":") + 1, len(line)).strip())
                }
            }
            let body = parts.slice(1, len(parts)).join("\r\n\r\n")
            while (len(body) < clen) {
                let more = net.recv(c, 4096)
                if (len(more) == 0) { break }
                body = body + more
            }
            let reply = method + " " + body
            resp = "HTTP/1.1 200 OK\r\nContent-Length: " + str(len(reply)) + "\r\nConnection: close\r\n\r\n" + reply
        }
        elif (path == "/echo") {
            let seen = []
            for (line in req.split("\r\n")) {
                let lower = line.lower()
                if (lower.startsWith("authorization:") || lower.startsWith("cookie:") ||
                    lower.startsWith("proxy-authorization:") || lower.startsWith("x-api-key:") ||
                    lower.startsWith("x-trace:") || lower.startsWith("accept:")) {
                    seen.push(lower.slice(0, lower.indexOf(":")))
                }
            }
            let body = seen.join(",")
            resp = "HTTP/1.1 200 OK\r\nContent-Length: " + str(len(body)) + "\r\nConnection: close\r\n\r\n" + body
        }
        else {
            resp = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
        }
        net.send(c, resp)
        net.close(c)
    }
}()
time.sleep(200)

let base = "http://localhost:" + str(TEST_PORT)
let creds = {
    "Authorization": "Bearer SECRET",
    "Cookie": "sid=abc",
    "Proxy-Authorization": "Basic xyz",
    "X-API-Key": "k-123",
    "X-Trace": "1",
    "Accept": "application/json"
}
let allNames = ["accept", "authorization", "cookie", "proxy-authorization", "x-api-key", "x-trace"]

func withHeaders(h) {
    return {blockPrivateHosts: false, headers: h}
}

// Header order on the wire isn't defined, so compare sorted names
func names(body) {
    if (body == "") { return [] }
    return sort(body.split(","))
}

testing.test("cross-origin redirect forwards only standard non-credential headers", lam{ in
    let r = http.get(base + "/cross", withHeaders(creds))
    testing.expectEqual(r.status, 200, nil)
    testing.expectEqual(names(r.body), ["accept"], "custom headers like X-API-Key must not follow")
})

testing.test("credential headers are matched case-insensitively", lam{ in
    let r = http.get(base + "/cross", withHeaders({"authorization": "Bearer SECRET", "COOKIE": "sid=abc"}))
    testing.expectEqual(r.body, "", nil)
})

testing.test("same-origin redirect keeps every header", lam{ in
    let r = http.get(base + "/same", withHeaders(creds))
    testing.expectEqual(names(r.body), allNames, nil)
})

testing.test("redirectHeaders: \"all\" forwards everything cross-origin", lam{ in
    let r = http.get(base + "/cross", {blockPrivateHosts: false, headers: creds, redirectHeaders: "all"})
    testing.expectEqual(names(r.body), allNames, nil)

    let s = http.session({blockPrivateHosts: false, headers: creds, redirectHeaders: "all"})
    testing.expectEqual(names(http.get(s, base + "/cross").body), allNames, "session default")
    http.close(s)
})

testing.test("redirectHeaders rejects unknown values", lam{ in
    testing.expectThrows(lam{ in http.get(base + "/same", {blockPrivateHosts: false, redirectHeaders: "yes"}) }, nil)
})

testing.test("session default headers are dropped on cross-origin redirect", lam{ in
    let s = http.session({blockPrivateHosts: false, headers: {"Authorization": "Bearer SECRET"}})
    let r = http.get(s, base + "/cross")
    testing.expectEqual(r.body, "", nil)
    http.close(s)
})

// A 307/308 resends the body; cross-origin that's refused unless the
// caller trusts redirects.

// Message of the error `fn` throws, or nil
func errorOf(fn) {
    try { fn() } catch (e) { return str(e) }
    return nil
}

testing.test("cross-origin 307 with a body is refused", lam{ in
    let msg = errorOf(lam{ in
        http.request({method: "POST", url: base + "/cross307", body: "password=hunter2", blockPrivateHosts: false})
    })
    testing.expectContains(msg, "refusing to resend the request body to another origin", nil)
})

testing.test("cross-origin 307 without a body is followed", lam{ in
    let r = http.get(base + "/cross307", _LH)
    testing.expectEqual(r.status, 200, nil)
    testing.expectEqual(r.body, "GET ", nil)
})

testing.test("same-origin 307 resends the body", lam{ in
    let r = http.request({method: "POST", url: base + "/same307", body: "x=1", blockPrivateHosts: false})
    testing.expectEqual(r.status, 200, nil)
    testing.expectEqual(r.body, "POST x=1", "target received the method and body")
})

testing.test("redirectHeaders: \"all\" allows resending the body cross-origin", lam{ in
    let r = http.request({method: "POST", url: base + "/cross307", body: "x=1",
                          blockPrivateHosts: false, redirectHeaders: "all"})
    testing.expectEqual(r.status, 200, nil)
    testing.expectEqual(r.body, "POST x=1", "target received the method and body")
})

testing.test("http.post honours a per-call redirectHeaders over the session default", lam{ in
    let s = http.session({blockPrivateHosts: false, redirectHeaders: "all"})
    let r = http.post(s, base + "/cross307", "x=1")
    testing.expectEqual(r.status, 200, "session default \"all\"")
    testing.expectEqual(r.body, "POST x=1", "target received the method and body")
    let msg = errorOf(lam{ in http.post(s, base + "/cross307", {body: "x=1", redirectHeaders: "safe"}) })
    testing.expectContains(msg, "refusing to resend the request body", "per-call \"safe\" tightens it")
    http.close(s)
})

testing.test("streaming request drops credentials on cross-origin redirect", lam{ in
    let st = http.openStream({url: base + "/cross", blockPrivateHosts: false, headers: creds})
    testing.expectEqual(st.status, 200, nil)
    testing.expectEqual(names(st.readAll()), ["accept"], nil)
    st.close()
})

testing.done()
