use "testing"

// if/elif/else, while, for and ensure-else take a single statement
// as their body, as in C: `if (x) print(x)`

testing.test("braceless if / elif / else", lam{ in
    func grade(n) {
        if (n >= 90) return "A" elif (n >= 80) return "B" else return "C"
    }
    testing.expectEqual(grade(95), "A", nil)
    testing.expectEqual(grade(85), "B", nil)
    testing.expectEqual(grade(10), "C", nil)

    let out = []
    if (true) out.push(1)
    if (false) out.push(2)
    if (false) { out.push(3) } else out.push(4)
    if (true) out.push(5) else { out.push(6) }
    testing.expectEqual(out, [1, 4, 5], "mixed with braced branches")
})

testing.test("bodies on the next line", lam{ in
    let r = nil
    if (false)
        r = "then"
    else
        r = "else"
    testing.expectEqual(r, "else", nil)
})

testing.test("semicolon before else", lam{ in
    let r = nil
    if (false) r = 1; else r = 2
    testing.expectEqual(r, 2, nil)
    if (false) r = 1; elif (true) r = 3; else r = 4
    testing.expectEqual(r, 3, nil)
})

testing.test("else binds to the nearest if", lam{ in
    let r = "unset"
    if (true) if (false) r = "inner then" else r = "inner else"
    testing.expectEqual(r, "inner else", nil)
    r = "unset"
    if (false) if (true) r = "inner then" else r = "inner else"
    testing.expectEqual(r, "unset", "the else is the inner if's")
})

testing.test("else if", lam{ in
    func sign(n) {
        if (n < 0) return -1 else if (n > 0) return 1 else return 0
    }
    testing.expectEqual(map([-5, 0, 5], sign), [-1, 0, 1], nil)
})

testing.test("braceless loops", lam{ in
    let i = 0
    while (i < 5) i += 1
    testing.expectEqual(i, 5, "while")

    let total = 0
    for (j in 0..10) total += j
    testing.expectEqual(total, 45, "range for")

    let odd = []
    for (v in [1, 2, 3, 4, 5, 6]) if (v % 2 == 0) continue else odd.push(v)
    testing.expectEqual(odd, [1, 3, 5], "continue")

    let seen = []
    for (v in [1, 2, 3, 4]) if (v == 3) break else seen.push(v)
    testing.expectEqual(seen, [1, 2], "break")

    let keys = []
    for ({key, value} in {a: 1}) keys.push(key + str(value))
    testing.expectEqual(keys, ["a1"], "destructuring for")
})

testing.test("braceless ensure else", lam{ in
    func check(n) {
        ensure (n != nil) else return "nil"
        ensure let m = n.positive else return "missing"
        return m
    }
    testing.expectEqual(check(nil), "nil", nil)
    testing.expectEqual(check({}), "missing", nil)
    testing.expectEqual(check({positive: 7}), 7, nil)
})

testing.test("parse errors", lam{ in
    let dir = testing.tempDir()
    let cases = [
        ["if (true) let y = 1\n", "a declaration needs braces"],
        ["while (true) func f() {}\n", "a declaration needs braces"],
        ["if (true)", "Expected a statement or '{'"],
        ["if (true) print(1) print(2)\n", "Expected ';' or newline"],
    ]
    for (engine in [[], ["--tree"]]) {
        for (c in cases) {
            let file = path.join(dir, "case.praia")
            fs.write(file, c[0])
            let r = sys.exec(["./praia", ...engine, file])
            testing.expectEqual(r.exitCode, 2, "%{engine} %{c[0]}")
            testing.expectContains(r.stderr, c[1], "%{engine} %{c[0]}")
        }
    }
})

testing.done()
