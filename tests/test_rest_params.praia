use "testing"

testing.test("rest param collects all args", lam{ in
    func f(...args) { return args }
    testing.expectEqual(f(1, 2, 3), [1, 2, 3], nil)
})

testing.test("rest param with no args", lam{ in
    func f(...args) { return args }
    testing.expectEqual(f(), [], nil)
})

testing.test("rest param after regular params", lam{ in
    func f(a, b, ...rest) { return [a, b, rest] }
    testing.expectEqual(f(1, 2, 3, 4), [1, 2, [3, 4]], nil)
})

testing.test("rest param empty when all consumed by regular", lam{ in
    func f(a, b, ...rest) { return rest }
    testing.expectEqual(f(1, 2), [], nil)
})

testing.test("rest param with single regular param", lam{ in
    func f(first, ...rest) { return [first, len(rest)] }
    testing.expectEqual(f("a", "b", "c"), ["a", 2], nil)
})

testing.test("rest param in lambda", lam{ in
    let sum = lam{ ...nums in
        let total = 0
        for (n in nums) { total = total + n }
        return total
    }
    testing.expectEqual(sum(1, 2, 3, 4), 10, nil)
})

testing.test("rest param lambda with regular params", lam{ in
    let f = lam{ first, ...rest in [first, rest] }
    testing.expectEqual(f("x", 1, 2), ["x", [1, 2]], nil)
})

testing.test("rest param in class method", lam{ in
    class Logger {
        func init(prefix) { this.prefix = prefix }
        func log(...args) {
            return this.prefix + ": " + args.join(", ")
        }
    }
    let logger = Logger("[INFO]")
    testing.expectEqual(logger.log("hello", "world"), "[INFO]: hello, world", nil)
})

testing.test("rest param with spread in call", lam{ in
    func sum(...nums) {
        let total = 0
        for (n in nums) { total = total + n }
        return total
    }
    testing.expectEqual(sum(1, 2, 3), 6, nil)
})

testing.test("rest param preserves order", lam{ in
    func f(...args) { return args }
    testing.expectEqual(f("a", "b", "c"), ["a", "b", "c"], nil)
})

testing.test("rest param with defaults", lam{ in
    func f(a, b = 10, ...rest) { return [a, b, rest] }
    testing.expectEqual(f(1, 2, 3, 4), [1, 2, [3, 4]], nil)
    testing.expectEqual(f(1), [1, 10, []], nil)
})

testing.test("calls with more than 255 arguments", lam{ in
    // Written out, since no one types 300 arguments; run on the VM, whose
    // calls used to keep the count in a byte
    let nums = []
    for (i in 0..300) { nums.push(str(i)) }
    let args = nums.join(", ")
    let file = path.join(testing.tempDir(), "args.praia")
    fs.write(file, "func f(...xs) { return len(xs) }\n" +
        "class C { func m(...xs) { return len(xs) } }\n" +
        "print(f(" + args + "))\n" +
        "print(C().m(" + args + "))\n" +
        "print(1 |> f(" + args + "))\n" +
        "print(len(str(Pt(" + args + "))))\n")
    let r = sys.exec(["./praia", file])
    testing.expectEqual(r.stdout, "300\n300\n301\n1392", r.stderr)
})

testing.done()
