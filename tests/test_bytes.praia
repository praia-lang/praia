use "testing"

testing.test("bytes.from array to string", lam{ in
    let raw = bytes.from([72, 101, 108, 108, 111])
    testing.expectEqual(raw, "Hello", nil)
})

testing.test("bytes.toArray string to array", lam{ in
    let arr = bytes.toArray("Hello")
    testing.expectEqual(arr, [72, 101, 108, 108, 111], nil)
})

testing.test("bytes.from and toArray roundtrip", lam{ in
    let original = [0, 127, 255, 1, 128]
    let raw = bytes.from(original)
    let back = bytes.toArray(raw)
    testing.expectEqual(back, original, nil)
})

testing.test("bytes.hex", lam{ in
    testing.expectEqual(bytes.hex("ABC"), "414243", nil)
    testing.expectEqual(bytes.hex(""), "", nil)
    testing.expectEqual(bytes.hex(fromCharCode(0)), "00", nil)
    testing.expectEqual(bytes.hex(fromCharCode(255)), "c3bf", "U+00FF encodes as 2 UTF-8 bytes")
})

testing.test("bytes.fromHex", lam{ in
    testing.expectEqual(bytes.fromHex("414243"), "ABC", nil)
    testing.expectEqual(bytes.fromHex(""), "", nil)
    testing.expectEqual(bytes.fromHex("00c3bf"), fromCharCode(0) + fromCharCode(255), "U+00FF = C3 BF in UTF-8")
})

testing.test("bytes.fromHex rejects odd length", lam{ in
    testing.expectThrows(lam{ in bytes.fromHex("abc") }, nil)
})

testing.test("bytes.hex and fromHex roundtrip", lam{ in
    let data = bytes.from([0, 1, 127, 128, 254, 255])
    testing.expectEqual(bytes.fromHex(bytes.hex(data)), data, nil)
})

testing.test("bytes.len", lam{ in
    testing.expectEqual(bytes.len("hello"), 5, nil)
    testing.expectEqual(bytes.len(""), 0, nil)
    testing.expectEqual(bytes.len(fromCharCode(0) + fromCharCode(0)), 2, nil)
})

testing.test("bytes.pack B", lam{ in
    let packed = bytes.pack("3B", [65, 66, 67])
    testing.expectEqual(packed, "ABC", nil)
})

testing.test("bytes.unpack B", lam{ in
    let vals = bytes.unpack("3B", "ABC")
    testing.expectEqual(vals, [65, 66, 67], nil)
})

testing.test("bytes.pack/unpack >H roundtrip", lam{ in
    let packed = bytes.pack(">2H", [8080, 443])
    let unpacked = bytes.unpack(">2H", packed)
    testing.expectEqual(unpacked, [8080, 443], nil)
})

testing.test("bytes.pack/unpack <I roundtrip", lam{ in
    let packed = bytes.pack("<I", [123456789])
    let unpacked = bytes.unpack("<I", packed)
    testing.expectEqual(unpacked, [123456789], nil)
})

testing.test("bytes.pack struct multi-field", lam{ in
    let data = bytes.pack(">BHI", [0xFF, 1234, 100000])
    testing.expectEqual(bytes.len(data), 7, nil)
    let vals = bytes.unpack(">BHI", data)
    testing.expectEqual(vals, [0xFF, 1234, 100000], nil)
})

testing.test("bytes.calcsize", lam{ in
    testing.expectEqual(bytes.calcsize(">BHI"), 7, nil)
    testing.expectEqual(bytes.calcsize(">3B2Hd"), 15, nil)
    testing.expectEqual(bytes.calcsize("4x"), 4, nil)
})

testing.test("format size is capped before anything is allocated", lam{ in
    // "16000000x" eight times describes 128 MB; refused up front instead
    // of expanding into millions of fields
    testing.expectThrows(lam{ in bytes.unpack("16000000x" * 8, "") }, nil)
    testing.expectThrows(lam{ in bytes.pack("16000000x" * 8, []) }, nil)
    // A format bigger than the data fails before decoding any of it
    testing.expectThrows(lam{ in bytes.unpack("16000000x", "") }, nil)
    testing.expectEqual(bytes.calcsize("16000000x"), 16000000, nil)
})

testing.test("repeat counts still pack and unpack element by element", lam{ in
    let p = bytes.pack(">3BHI2xq", [1, 2, 3, 500, 70000, -5])
    testing.expectEqual(bytes.len(p), 19, nil)   // 3 + 2 + 4 + 2 + 8
    testing.expectEqual(bytes.unpack(">3BHI2xq", p), [1, 2, 3, 500, 70000, -5], nil)
    testing.expectEqual(bytes.unpack(">2fd", bytes.pack(">2fd", [1.5, -2.25, 3.125])), [1.5, -2.25, 3.125], nil)
})

testing.test("pack rejects numbers outside the integer range", lam{ in
    let inf = 1e308 * 10
    testing.expectThrows(lam{ in bytes.pack(">q", [1e30]) }, nil)
    testing.expectThrows(lam{ in bytes.pack(">q", [inf]) }, nil)
    testing.expectEqual(bytes.unpack(">q", bytes.pack(">q", [2.9])), [2], "truncated toward zero")
})

testing.done()
